---
import Layout from "@/layouts/Layout.astro";
const pageTitle = "Home";
---

<Layout pageTitle={pageTitle}>
  <section class="hero-content">
    <h1>欢迎来到 RottenSea 的个人空间</h1>
    <p>一个记录技术、生活与思考的地方。</p>
  </section>
</Layout>

<style>
  .hero-content {
    text-align: center;
    padding: 4rem 0;
  }

  .hero-content h1 {
    font-size: 2rem;
    color: var(--text-100);
  }

  .hero-content p {
    color: var(--text-400);
    font-size: 1.1rem;
  }
</style>
