---
import Navigation from "./Navigation.astro";

import { getImage } from "astro:assets";

import "@/styles/header.css";

import bgImage from "@/assets/background/130258907_p0.png";

const optimizedBackground = await getImage({
  src: bgImage,
  format: "avif",
});
---

<div
  class="header-inner"
  style="height: 100vh; position: relative;"
>
  <nav
    id="navbar"
    class="navbar scrolling-navbar"
  >
    <div class="nav-container">
      <a
        class="navbar-brand"
        href="/"
        >RottenSea's Cafe</a
      >
      <div class="navbar-collapse">
        <Navigation />
      </div>
    </div>
  </nav>
  <div
    id="banner"
    class="banner"
    style={`background-image: url(${optimizedBackground.src});`}
  >
    <div class="banner-mask">
      <div class="banner-text">欢迎</div>
    </div>
  </div>
</div>

<script>
  const navbar = document.getElementById("navbar");
  if (navbar) {
    const toggleNavbar = () => {
      navbar.classList.toggle("top-nav-collapse", window.scrollY > 50);
    };
    window.addEventListener("scroll", toggleNavbar, { passive: true });
    toggleNavbar();
  }
</script>
