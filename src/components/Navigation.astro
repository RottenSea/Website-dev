---
import HomeIcon from "@/assets/icon/home_fill_light.svg";
import ArchiveIcon from "@/assets/icon/archive-fill.svg";
const navLinks = [
  { href: "/", label: "首页", icon: HomeIcon },
  { href: "/blog", label: "博客", icon: ArchiveIcon },
];
---

<nav class="main-navigation">
  <ul class="nav-list">
    {
      navLinks.map((link) => (
        <li class="nav-item">
          <a
            href={link.href}
            class={Astro.url.pathname === link.href ? "active" : ""}
          >
            <link.icon
              class="nav-icon"
              fill="currentColor"
              width="16"
              height="16"
            />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
