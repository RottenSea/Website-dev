---
const navLinks = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
];
---

<style>
  @import "@/styles/header.css";
</style>

<nav class="main-navigation">
  <ul class="nav-list">
    {
      navLinks.map((link) => (
        <li class="nav-item">
          <a
            href={link.href}
            class={Astro.url.pathname === link.href ? "active" : ""}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
