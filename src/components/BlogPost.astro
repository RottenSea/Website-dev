---
export interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  href: string;
}

const { title, date, description, tags, href } = Astro.props;
---

<article class="blog-card">
  <a href={href}>
    <h2>{title}</h2>
    <time>{date.toDateString()}</time>
    {description && <p class="description">{description}</p>}
    {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => <span class="card-tag">{tag}</span>)}
      </div>
    )}
  </a>
</article>
